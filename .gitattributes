# Auto detect text files and perform LF normalization
* text=auto

# 二进制资源：禁止换行转换，也不要当作文本 diff
*.dex binary
*.so binary
*.jar binary
*.keystore binary
*.apk binary
*.arsc binary
*.webp binary
*.png binary
*.jpg binary

# 脚本换行：shell 必须 LF（否则 Linux/macOS 报 "bad interpreter: ^M"），
# Windows 批处理必须 CRLF（否则 cmd 解析 goto 标签可能出错）
*.sh text eol=lf
*.bat text eol=crlf
*.ps1 text eol=crlf
